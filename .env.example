# Postgres connection string
DATABASE_URL=

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=
# GitHub OAuth app (callback: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: GitHub login that receives applications created before sign-in existed
CLAIM_UNOWNED_GITHUB_LOGIN=

# Tests only: put this in .env.test.local (gitignored), never in .env.
# A separate test database (e.g. a Neon "test" branch). Tests create and
# delete their own rows, and refuse to run against DATABASE_URL's database.
TEST_DATABASE_URL=
